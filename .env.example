# Google ADK
GOOGLE_API_KEY=your_google_api_key_here

# ServiceNow — preencha com as credenciais da sua instância
SERVICENOW_INSTANCE=your_instance      # ex: mycompany (sem .service-now.com)
SERVICENOW_USERNAME=your_username
SERVICENOW_PASSWORD=your_password

# Opcional: Bearer token (tem prioridade sobre basic auth se definido)
# SERVICENOW_API_TOKEN=your_bearer_token
